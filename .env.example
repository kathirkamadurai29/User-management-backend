# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# JWT Configuration (for authentication and hard tenant isolation)
JWT_SECRET=super_secret_jwt_signing_key_replace_in_production_min32chars
JWT_EXPIRES_IN=24h

# Supabase Configuration (PostgreSQL clients table)
# Obtain these from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# MongoDB Configuration (Tenants Users CRUD & Activity Logs)
# Example local: mongodb://localhost:27017
# Example Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=user_platform

# Firebase Admin SDK Configuration (Notification & Event triggering on user create/delete)
# Can be configured via individual environment variables or a path to serviceAccountKey.json
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
# Or optional path:
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# AI Insights Configuration (LLM summarization for GET /insights)
# Google Gemini API key or compatible LLM provider key
GEMINI_API_KEY=your_gemini_api_key_here
