          }
        },
        {
          "name": "View Global Telemetry Across All Tenants",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/activity?limit=100",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "activity"],
              "query": [
                { "key": "limit", "value": "100" }
              ]
            }
          }
        }
      ]
    }
  ]
}
