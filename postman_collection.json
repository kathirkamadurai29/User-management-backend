        },
        {
          "name": "Generate AI Operational Insight",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{sessionToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/insights",
              "host": ["{{baseUrl}}"],
              "path": ["insights"]
            }
          }
        }
      ]
    },
